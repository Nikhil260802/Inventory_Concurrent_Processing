                {
                  "key": "mode",
                  "value": "PARALLEL"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select your CSV file (e.g. sample_data/inputs/sample_valid_5.csv or inventory_10000.csv)"
                }
              ]
            },
            "description": "Upload a CSV file for parallel concurrent processing. Select the file manually in Postman's Body > form-data tab.\n\nExpected CSV headers: code,name,batch_number,quantity,price,expiry_date"
          },
          "response": []
        },
        {
          "name": "Upload CSV - SEQUENTIAL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/upload?mode=SEQUENTIAL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "upload"],
              "query": [
                {
                  "key": "mode",
                  "value": "SEQUENTIAL"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select your CSV file (e.g. sample_data/inputs/sample_valid_5.csv or inventory_10000.csv)"
                }
              ]
            },
            "description": "Upload a CSV file for sequential (single-threaded) processing. Used for benchmarking comparison against PARALLEL mode."
          },
          "response": []
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "{{jobId}}"]
            },
            "description": "Get the full status and metrics for a processing job by its ID.\n\nReturns: jobId, status (PENDING/RUNNING/COMPLETED/FAILED), totalRecords, successfulRecords, failedRecords, duplicateRecords, executionTimeMs, throughputRecordsPerSec, peakMemoryMb, processingMode."
          },
          "response": []
        },
        {
          "name": "Get Job Errors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/{{jobId}}/errors?page=0&size=50&sort=csvRowNumber,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "{{jobId}}", "errors"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "csvRowNumber,asc"
                }
              ]
            },
            "description": "Retrieve paginated error records for a processing job. Shows which CSV rows failed and why."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inventory Management & Search",
      "item": [
