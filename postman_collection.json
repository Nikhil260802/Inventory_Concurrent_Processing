                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "name,asc",
                  "description": "Sort field and direction. Options: name,asc | price,desc | quantity,asc | etc."
                }
              ]
            },
            "description": "Search inventory items with pagination and sorting. The 'query' parameter searches across code, name, and batchNumber fields."
          },
          "response": []
