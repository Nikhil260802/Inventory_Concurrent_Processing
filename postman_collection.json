      "name": "CSV Processing & Jobs",
      "item": [
        {
          "name": "Upload CSV - PARALLEL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/upload?mode=PARALLEL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "upload"],
